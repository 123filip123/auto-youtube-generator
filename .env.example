# Required
OPENAI_API_KEY=sk-your-key-here

# Model tier: `draft` (cheap, the default) or `quality` (expensive, for a
# video you intend to publish). Sets TEXT_MODEL, TEXT_TEMPERATURE, IMAGE_MODEL,
# IMAGE_SIZE and IMAGE_QUALITY together -- see the README.
# MODEL_TIER=draft

# Optional overrides (draft-tier defaults shown, see config.py). Anything set
# here wins over the tier.
# TEXT_MODEL=gpt-4.1-mini
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=ash
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024
# IMAGE_QUALITY=medium
# TARGET_VIDEO_SECONDS=85
# MAX_CONCURRENT_REQUESTS=4
# MAX_RETRIES=5
# VIDEO_FPS=24
# VIDEO_PRESET=medium
